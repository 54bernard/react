# ---------------------------------------------------------------
# Progrès Habitat — variables d'environnement
# Copiez ce fichier en `.env.local` puis renseignez les valeurs.
# Sans Supabase, le site fonctionne en MODE DÉMONSTRATION (données locales).
# ---------------------------------------------------------------

# URL publique du site (sans slash final) — utilisée pour le SEO, le sitemap et Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Cartographie ---
# Clé Google Maps JavaScript API (facultative : sans clé, la carte utilise OpenStreetMap)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID Google (facultatif, requis pour les marqueurs avancés stylisés)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Analytics (facultatif) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- E-mails de notification via Resend (facultatif, côté serveur uniquement) ---
RESEND_API_KEY=
# Expéditeur vérifié dans Resend, ex. "Progrès Habitat <notifications@votredomaine.com>"
EMAIL_FROM=
# Adresse qui reçoit les nouvelles demandes clients
EMAIL_TO=
